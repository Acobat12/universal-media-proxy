+import { VOTNextWorkerProvider } from "@vot.js/core/providers/votworker";
+
+const encoder = new TextEncoder();
+
+const ALLOWED_HEADER =
+  /^(?:sec-vtrans-[a-z0-9-]+|sec-vsubs-[a-z0-9-]+|vtrans-[a-z0-9-]+|vsubs-[a-z0-9-]+|sec-ch-ua(?:-[a-z0-9-]+)?|accept-language|authorization|pragma|cache-control)$/;
+
+function varint(value: number): number[] {
+  if (!Number.isSafeInteger(value) || value < 0) {
+    throw new Error("Invalid protobuf length");
+  }
+
+  const bytes: number[] = [];
+
+  do {
+    const low = value % 128;
+    value = Math.floor(value / 128);
+    bytes.push(value ? low | 128 : low);
+  } while (value);
+
+  return bytes;
+}
+
+function field(tag: number, data: Uint8Array): Uint8Array {
+  const length = varint(data.byteLength);
+  const result = new Uint8Array(
+    1 + length.length + data.byteLength
+  );
+
+  result[0] = tag;
+  result.set(length, 1);
+  result.set(data, 1 + length.length);
+
+  return result;
+}
+
+function concat(parts: Uint8Array[]): Uint8Array {
+  const result = new Uint8Array(
+    parts.reduce((sum, part) => sum + part.length, 0)
+  );
+
+  let offset = 0;
+
+  for (const part of parts) {
+    result.set(part, offset);
+    offset += part.length;
+  }
+
+  return result;
+}
+
+export function encodeVotEnvelope(
+  headers: Record<string, string>,
+  body: Uint8Array,
+  path: string,
+): Uint8Array {
+  const parts: Uint8Array[] = [];
+
+  for (const [key, value] of Object.entries(headers)) {
+    const name = key.toLowerCase();
+
+    if (
+      !ALLOWED_HEADER.test(name) ||
+      typeof value !== "string" ||
+      value.length > 4096 ||
+      /[\x00-\x1f\x7f]/.test(value)
+    ) {
+      continue;
+    }
+
+    const entry = concat([
+      field(10, encoder.encode(name)),
+      field(18, encoder.encode(value)),
+    ]);
+
+    parts.push(field(10, entry));
+  }
+
+  parts.push(field(18, body));
+  parts.push(field(26, encoder.encode(path)));
+
+  return concat(parts);
+}
+
+export class VOTProtobufEnvelopeProvider
+  extends VOTNextWorkerProvider {
+
+  mergeHeaders(...headers: Record<string, string>[]) {
+    return Object.assign({}, this.headers, ...headers);
+  }
+
+  async request(
+    path: string,
+    body: Uint8Array | ArrayBuffer | Blob,
+    headers: Record<string, string> = {},
+    method = "POST",
+    fetchOpts: Record<string, unknown> = {},
+  ): Promise<{ success: boolean; data: ArrayBuffer | string }> {
+    try {
+      const bytes =
+        body instanceof Blob
+          ? new Uint8Array(await body.arrayBuffer())
+          : body instanceof ArrayBuffer
+            ? new Uint8Array(body)
+            : new Uint8Array(body);
+
+      const envelope = encodeVotEnvelope(
+        headers,
+        bytes,
+        path
+      );
+
+      const options = this.getOpts(
+        envelope,
+        {
+          "Content-Type":
+            "application/x-vot-envelope+protobuf",
+        },
+        method,
+        fetchOpts
+      );
+
+      options.headers = {
+        "Content-Type":
+          "application/x-vot-envelope+protobuf",
+      };
+
+      const origin =
+        `${this.schema}://${String(this.host)
+          .replace(/^https?:\/\//i, "")}`;
+
+      const response = await this.fetch(
+        `${origin}${path}`,
+        options
+      );
+
+      return {
+        success: response.status === 200,
+        data: await response.arrayBuffer(),
+      };
+    } catch (error) {
+      return {
+        success: false,
+        data: error instanceof Error
+          ? error.message
+          : String(error),
+      };
+    }
+  }
